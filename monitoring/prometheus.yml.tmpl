global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: secure-messenger-api
    static_configs:
      - targets: ["backend:8000"]

  - job_name: secure-messenger-websocket
    metrics_path: /api/v1/realtime/health
    static_configs:
      - targets: ["backend:8000"]

  - job_name: minio-storage
    metrics_path: /minio/v2/metrics/cluster
    static_configs:
      - targets: ["minio:9000"]

  - job_name: public-tls
    metrics_path: /probe
    params:
      module: [https_2xx]
    static_configs:
      - targets: ["__PUBLIC_ORIGIN__"]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: __address__
        replacement: blackbox:9115
