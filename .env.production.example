# Copy outside the repository, fill with randomly generated values, and protect
# it with the deployment secret manager. Do not reuse development credentials.
POSTGRES_DB=secure_messenger
POSTGRES_USER=secure_messenger
POSTGRES_PASSWORD=<random-postgres-password>
REDIS_PASSWORD=<random-redis-password>
S3_ACCESS_KEY_ID=<production-s3-access-key>
S3_SECRET_ACCESS_KEY=<production-s3-secret>
S3_BUCKET=secure-messenger-media
S3_REGION=us-east-1
PUBLIC_ORIGIN=https://messenger.example
