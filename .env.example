APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./secure_messenger.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SQL_ECHO=false
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=2592000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Production example:
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://secure_messenger:change-me@db:5432/secure_messenger
# REDIS_URL=redis://redis:6379/0
