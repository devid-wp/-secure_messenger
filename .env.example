APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./secure_messenger.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SQL_ECHO=false
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=2592000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Production example:
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://secure_messenger:change-me@db:5432/secure_messenger
# REDIS_URL=redis://redis:6379/0
# Media objects use local storage in development. Set these values for MinIO,
# Cloudflare R2, Backblaze B2, or another S3-compatible production service.
MEDIA_STORAGE_BACKEND=local
MEDIA_DIR=./media
# S3_ENDPOINT_URL=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=secure-messenger-media
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me
